# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/src/packages/*/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# AWS CDK (infra/)
/infra/node_modules
/infra/cdk.out

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example
!.env.cloud.example

# Local agent and design tooling: worktrees, reports, symlinked skills and Impeccable's
# screenshots stay on the machine. Only the project's plugin list is shared.
/.claude/*
!/.claude/settings.json
/.impeccable/

# generated by pnpm content:build
/src/content/.generated/

# SERP probe results (scripts/serp-probe.mjs)
/.serp-probe/
