# Copy to .env.local for `pnpm dev`, or to .env for `docker compose up`. This is what running SEOpen
# on your own machine needs: only DATABASE_URL and SEOPEN_SECRET_KEY are required to start, and
# research needs the DataForSEO login. Settings for serving a copy to other people (a domain, email,
# alerts) are in docs/self-hosting.md.

# ── Required ─────────────────────────────────────────────────────────────────────────────────────

DATABASE_URL=postgres://localhost:5432/seopen
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts Google tokens at rest, signs the
# weekly recap's unsubscribe links and, unless BETTER_AUTH_SECRET is set, sign-in sessions.
# Changing it signs everyone out and breaks the links already sent.
SEOPEN_SECRET_KEY=

# ── Signing in ───────────────────────────────────────────────────────────────────────────────────

# No login on your own machine: the app opens signed in as its owner, with no password.
# Keep the port bound to 127.0.0.1 while this is on: it can't tell whether other machines can reach
# the port, so don't rely on it to turn itself off (README.md, "Signing in"). Remove it and set a
# password before anything else can reach this copy: securing it is up to you (docs/self-hosting.md).
SEOPEN_NO_LOGIN=1

# ── Data ─────────────────────────────────────────────────────────────────────────────────────────

# DataForSEO API credentials. No account yet? https://try.dataforseo.com/65m65rikt8ny (an affiliate
# link). Use the API password from https://app.dataforseo.com/api-access, not the account one.
# Unset: research, rank, audit, backlinks, Local and AI visibility refuse to run.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Your workspace's monthly DataForSEO spend cap in USD (default 75).
DATAFORSEO_MONTHLY_CAP_USD=75

# ── Google (optional) ────────────────────────────────────────────────────────────────────────────

# Google OAuth client for Search Console and GA4 (see docs/google.md). Bring your own Google Cloud project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4100/api/google/callback

# Google Maps Static API for the Local SEO map: an API key limited to the Maps Static API and the
# project's URL signing secret (server only). Unset: the map uses OpenStreetMap tiles, which is fine
# locally but not for commercial use.
GOOGLE_MAPS_STATIC_KEY=
GOOGLE_MAPS_SIGNING_SECRET=

# ── Optional features ────────────────────────────────────────────────────────────────────────────

# Claude for guided setup's review. Unset: the review is off. Its calls count against your spend cap.
ANTHROPIC_API_KEY=

# ── Email and alerts (optional) ──────────────────────────────────────────────────────────────────

# Emails you when the spend cap nears, the DataForSEO balance runs low or the account runs out.
# Unset: those alerts go to the server log only. Steps, Resend's test sender included, in
# docs/self-hosting.md, "Email and alerts".
RESEND_API_KEY=
# The sender, on a domain verified in Resend, for example: SEOpen <seo@example.com>
EMAIL_FROM=
# Where your alerts go.
OWNER_ALERT_EMAIL=

# ── Docker (compose.yaml) ────────────────────────────────────────────────────────────────────────

# The password compose gives its Postgres (letters and digits, since it goes into a URL). It builds
# DATABASE_URL for the web app and worker itself, so DATABASE_URL above is only for `pnpm dev`.
POSTGRES_PASSWORD=

# ── Try it without accounts ──────────────────────────────────────────────────────────────────────

# 1 serves generated data instead of calling the provider, so those pages fill in with no account.
SEOPEN_GOOGLE_FIXTURES=
SEOPEN_POSTHOG_FIXTURES=
SEOPEN_PLAUSIBLE_FIXTURES=
SEOPEN_UMAMI_FIXTURES=
