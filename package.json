{
  "name": "seopen",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "pnpm content:build && next dev -H 127.0.0.1 -p 4100",
    "build": "pnpm content:build && pnpm seo:check && next build && pnpm css:check",
    "content:build": "tsx scripts/run-if-present.ts scripts/content/build.ts",
    "css:check": "tsx scripts/css/check.ts",
    "seo:check": "tsx scripts/run-if-present.ts scripts/seo/check.ts",
    "seo:lastmod": "tsx scripts/run-if-present.ts scripts/seo/lastmod.ts",
    "seo:crawl": "tsx scripts/run-if-present.ts scripts/seo/crawl.ts",
    "start": "next start -H 127.0.0.1 -p 4100",
    "worker": "tsx --env-file=.env.local src/worker.ts",
    "owner:create": "tsx --env-file-if-exists=.env.local scripts/create-owner.ts",
    "user:password": "tsx --env-file-if-exists=.env.local scripts/set-password.ts",
    "tools:setup": "tsx --env-file-if-exists=.env.local scripts/run-if-present.ts scripts/public-tools-setup.ts",
    "oss:export": "tsx scripts/run-if-present.ts scripts/oss/export.ts",
    "worker:dev": "tsx watch --env-file=.env.local src/worker.ts",
    "worker:start": "tsx --env-file-if-exists=.env.local src/worker.ts",
    "lint": "eslint",
    "typecheck": "pnpm content:build && next typegen && tsc --noEmit",
    "test": "pnpm content:build && vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:start": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@better-auth/cimd": "1.7.10",
    "@better-auth/mcp": "1.7.10",
    "@better-auth/oauth-provider": "1.7.10",
    "@googleapis/analyticsadmin": "^22",
    "@googleapis/analyticsdata": "^10",
    "@googleapis/searchconsole": "^11",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@next/mdx": "^16.4.3",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "disposable-email-domains": "^1.0.62",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.3",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.63.0",
    "next": "16.4.6",
    "p-limit": "^7.3.3",
    "pg-boss": "^12.38.0",
    "postgres": "^3.4.9",
    "posthog-js": "^1.444.0",
    "posthog-node": "^5.61.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "6.33.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tldts": "^7.4.19",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@tailwindcss/turbopack": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "linkedom": "^0.18.14",
    "schema-dts": "^2.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.4"
    }
  }
}
